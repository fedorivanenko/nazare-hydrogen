{
	"version": 1,
	"runtime": {
		"node": "24",
		"packageManager": "pnpm@10.17.1"
	},
	"dependencies": {
		"lockfile": "pnpm-lock.yaml",
		"install": "pnpm install --frozen-lockfile --prefer-offline --store-dir /workspace/.pnpm-store"
	},
	"compile": {
		"entrypoint": ".wind-tunnel/compile-subject.ts",
		"output": "/workspace/.wind-tunnel-subject.json"
	}
}
